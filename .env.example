# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored -- never commit real keys.

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------

# Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon / public key. Safe to expose: under our RLS policies it can only read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses every RLS policy.
# NOTE the missing NEXT_PUBLIC_ prefix -- that is deliberate. Adding it would
# inline this key into the browser bundle and hand anyone full write access to
# the database. It is only ever read in server-side code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------

# Password for the admin login. Checked on the server only.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. At least 32 characters.
# Generate one with:  openssl rand -hex 32
# Changing this immediately signs out every logged-in admin.
ADMIN_SESSION_SECRET=
