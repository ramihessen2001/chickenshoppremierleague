# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored -- never commit real keys.

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------

# Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon / public key. Safe to expose: under our RLS policies it can only read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses every RLS policy.
# NOTE the missing NEXT_PUBLIC_ prefix -- that is deliberate. Adding it would
# inline this key into the browser bundle and hand anyone full write access to
# the database. It is only ever read in server-side code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------

# Password for the  login. Checked on the server only.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. At least 32 characters.
# Generate one with:  openssl rand -hex 32
# Changing this immediately signs out every logged-in admin.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Public site URL
# ---------------------------------------------------------------------------

# Where the site is served from, with no trailing slash. Used to build the
# absolute URLs in the share card that WhatsApp, iMessage and the rest read.
# Leave it unset locally; set it in production.
NEXT_PUBLIC_SITE_URL=https://chickenshoppremierleague.vercel.app

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# Registration receipts with the payment details, and the note that goes out
# when a place is confirmed. Leave these blank and the site simply sends no
# email -- nothing else changes.

# API key from resend.com.
RESEND_API_KEY=

# The From address, e.g.  CSPL <noreply@your-domain.com>
# The domain has to be verified in Resend before anything will send.
EMAIL_FROM=

# Where replies go, if that is not the From address. Optional.
EMAIL_REPLY_TO=

# --- Klaviyo (optional) ------------------------------------------------------

# Marketing email. Leave all three blank and the site never contacts Klaviyo:
# no on-site tag, and the marketing box on the registration form still records
# consent in our own database for later.
#
# Nobody is added to a list by registering. Only people who tick the optional
# box are subscribed -- the form promises "We only use your details to run the
# league", and that promise is the reason the box exists.

# Public six-character company ID. Safe in the browser; this is the on-site tag.
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=

# Private API key. Server only -- the missing NEXT_PUBLIC_ prefix is deliberate,
# exactly as with SUPABASE_SERVICE_ROLE_KEY above. Do not add one.
KLAVIYO_PRIVATE_API_KEY=

# The list new subscribers are added to.
KLAVIYO_LIST_ID=
